---
import Base from '../layouts/Base.astro';
import { DONATION_PROVIDER_URL, ORG_EIN, ORG_EMAIL } from '../config.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Zeffy has no URL amount-prefill, so we embed the donation form inline for a
// single-step give-and-pay experience. Derive the embed URL from the configured
// Zeffy donation page URL (its last path segment is the form slug).
const slug = DONATION_PROVIDER_URL.split('/').filter(Boolean).pop();
const embedUrl = `https://www.zeffy.com/embed/donation-form/${slug}`;

const moreWays = [
  {
    n: '01',
    title: 'Clinical Volunteers',
    body: 'Licensed physicians, nurses, and allied health professionals are welcomed for missions. Non-clinical roles in logistics and coordination are also available.',
    cta: 'Volunteer Inquiry',
    reason: 'volunteer',
  },
  {
    n: '02',
    title: 'Institutional Partnerships',
    body: 'We partner with hospitals, medical schools, and corporations for supply donations, training collaborations, and program funding.',
    cta: 'Partnership Inquiry',
    reason: 'partnership',
  },
  {
    n: '03',
    title: 'Spread Awareness',
    body: 'Sharing our mission with colleagues and community groups expands our base of supporters and volunteers. Request an information packet to share.',
    cta: 'Request Information Packet',
    reason: 'packet',
  },
];
---

<Base
  title="Donate"
  seoTitle="Donate to Caribbean Healthcare | CaribHealth Foundation"
  path="donate"
  taxId={ORG_EIN}
  description="Give, volunteer clinical time, or partner your institution — every form of support extends our capacity to serve patients across the Caribbean. Tax-deductible 501(c)(3)."
>
  <div class="page-band">
    <div style="max-width:1100px;margin:0 auto;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={`${base}/`}>Home</a><span class="sep">/</span>Get Involved
      </nav>
      <h1>Get involved</h1>
      <p class="intro">
        Give, volunteer clinical time, or partner your institution &mdash; every
        form of support extends our capacity to serve patients across the
        Caribbean.
      </p>
    </div>
  </div>

  <section class="donate-section">
    <div class="donate-card">
      <div class="donate-head">
        <div>
          <div class="donate-title">Make a donation</div>
          <div class="donate-sub">Tax-deductible &middot; 501(c)(3) &middot; EIN {ORG_EIN}</div>
        </div>
        <a href="#matching-gifts" class="match-jump">Employer matching gift? Get our EIN &darr;</a>
      </div>

      <div class="donate-body">
        <div class="zeffy-embed">
          <iframe
            title="CaribHealth Foundation secure donation form"
            src={embedUrl}
            allow="payment"
            loading="lazy"
          ></iframe>
        </div>
        <p class="secure-note">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          Securely processed by Zeffy &mdash; a 0%-fee donation platform for nonprofits. Your gift is tax-deductible.
        </p>
      </div>
    </div>

    <!-- Employer matching gifts: everything an HR / matching-gift portal asks for. -->
    <section id="matching-gifts" class="match-card" aria-labelledby="match-title">
      <p class="match-eyebrow">Employer matching gifts</p>
      <h2 id="match-title" class="match-title">Double your impact with a matching gift</h2>
      <p class="match-lead">
        Many employers match their employees&rsquo; charitable donations. If yours
        does, use the details below in your company&rsquo;s matching-gift or
        workplace-giving program.
      </p>

      <div class="ein-box">
        <div>
          <div class="ein-label">EIN / Federal Tax ID</div>
          <div class="ein-value" id="ein-value">{ORG_EIN}</div>
        </div>
        <button type="button" class="btn btn-outline ein-copy" data-copy={ORG_EIN} hidden>
          Copy EIN
        </button>
        <span class="ein-status" role="status" aria-live="polite"></span>
      </div>

      <dl class="match-facts">
        <div><dt>Legal name</dt><dd>CaribHealth Foundation, Inc.</dd></div>
        <div><dt>Tax status</dt><dd>501(c)(3) nonprofit &middot; donations are tax-deductible</dd></div>
        <div><dt>Location</dt><dd>Orange, Connecticut, USA</dd></div>
        <div><dt>Gift verification</dt><dd><a href={`mailto:${ORG_EMAIL}`}>{ORG_EMAIL}</a></dd></div>
      </dl>

      <ol class="match-steps">
        <li>Make your donation using the form above.</li>
        <li>
          Find &ldquo;CaribHealth Foundation&rdquo; in your employer&rsquo;s giving
          portal (search by our EIN), or ask HR for a matching-gift request form.
        </li>
        <li>We&rsquo;ll confirm your donation when your employer contacts us.</li>
      </ol>
    </section>
  </section>

  <!-- More ways to help -->
  <section class="container" style="padding:clamp(1.5rem,3vw,2.5rem) clamp(1.25rem,4vw,2rem) clamp(3.5rem,6vw,5rem);">
    <p class="eyebrow" style="text-align:center;">More Ways to Help</p>
    <h2 class="section-title" style="text-align:center;margin:0 0 2.5rem;">Beyond a donation.</h2>
    <div class="ways-grid">
      {
        moreWays.map((w) => (
          <div class="way-card">
            <div class="way-num">{w.n}</div>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
            <a href={`${base}/contact?reason=${w.reason}`} class="btn btn-outline" style="width:100%;font-size:0.85rem;padding:0.65rem 1.2rem;">
              {w.cta}
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .donate-section {
    max-width: 660px;
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 4.5rem) clamp(1.25rem, 4vw, 2rem) clamp(2rem, 3vw, 3rem);
  }
  .donate-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 30px rgba(10, 31, 61, 0.06);
    overflow: hidden;
  }
  .donate-head {
    background: linear-gradient(135deg, var(--navy), var(--navy-2));
    color: #fff;
    padding: 1.5rem clamp(1.5rem, 3vw, 2rem);
  }
  .donate-title {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .donate-sub {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 0.2rem;
  }
  .donate-body {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .donate-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .match-jump {
    color: #fff;
    font-size: 0.82rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.45);
  }
  .match-jump:hover {
    text-decoration-color: #fff;
  }

  /* Employer matching gifts */
  .match-card {
    margin-top: 1.75rem;
    background: var(--tint);
    border: 1px solid var(--border-tint);
    border-radius: 6px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    scroll-margin-top: 6rem;
  }
  .match-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .match-title {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--navy);
    margin: 0 0 0.6rem;
    line-height: 1.3;
  }
  .match-lead {
    font-size: 0.92rem;
    color: var(--text-2);
    line-height: 1.65;
    margin: 0 0 1.25rem;
  }
  .ein-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    background: #fff;
    border: 1px solid var(--border-tint);
    border-left: 3px solid var(--gold);
    border-radius: 4px;
    padding: 1rem 1.25rem;
  }
  .ein-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .ein-value {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 600;
    color: var(--navy);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    user-select: all;
  }
  .ein-copy {
    font-size: 0.85rem;
    padding: 0.55rem 1.1rem;
  }
  .ein-status {
    flex-basis: 100%;
    font-size: 0.8rem;
    color: var(--navy-ink);
    min-height: 1em;
    margin-top: -0.25rem;
  }
  .ein-status:empty {
    display: none;
  }
  .match-facts {
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.6rem;
  }
  .match-facts > div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
  .match-facts dt {
    color: var(--muted);
  }
  .match-facts dd {
    margin: 0;
    color: var(--text);
  }
  @media (max-width: 480px) {
    .match-facts > div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
  .match-steps {
    list-style: decimal; /* Tailwind's reset removes list markers */
    margin: 1.25rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.6;
  }
  .match-steps li + li {
    margin-top: 0.35rem;
  }

  .zeffy-embed {
    width: 100%;
  }
  .zeffy-embed iframe {
    width: 100%;
    height: 560px;
    border: 0;
    border-radius: 4px;
    display: block;
  }
  @media (max-width: 600px) {
    .zeffy-embed iframe {
      height: 720px;
    }
  }

  .secure-note {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0.9rem 0 0;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }


  .ways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .way-card {
    background: #fff;
    border: 1px solid var(--border);
    padding: 2rem;
    transition: border-color 0.15s;
    display: flex;
    flex-direction: column;
  }
  .way-card:hover {
    border-color: var(--border-strong);
  }
  .way-num {
    font-family: var(--serif);
    color: var(--gold);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .way-card h3 {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--navy);
  }
  .way-card p {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.65;
    margin: 0 0 1.5rem;
    flex: 1;
  }
</style>

<script>
  // Progressive enhancement: show "Copy EIN" only where the Clipboard API works.
  const copyBtn = document.querySelector<HTMLButtonElement>('.ein-copy');
  const status = document.querySelector('.ein-status');
  if (copyBtn && navigator.clipboard && window.isSecureContext) {
    copyBtn.hidden = false;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.copy ?? '');
        if (status) status.textContent = 'EIN copied to clipboard.';
      } catch {
        if (status) status.textContent = 'Copy failed. Please select the number above.';
      }
    });
  }
</script>
